# IMPORTANTE:
# Este arquivo contém apenas um EXEMPLO.
# Nunca coloque senhas reais neste arquivo.
#
# O ASP.NET Core converte:
#
# ConnectionStrings__ConexaoPadrao
#
# para:
#
# ConnectionStrings:ConexaoPadrao
#
# Exemplo para SQL Server:
ConnectionStrings__ConexaoPadrao="Server=localhost,1433;Database=FuncionarioPattern;User Id=sa;Password=SUA_SENHA_AQUI;TrustServerCertificate=True"
